<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">


    <fragment
        android:id="@+id/nav_home"
        android:name="io.cloink.client.ui.home.HomeFragment"
        android:label="" />

    <fragment
        android:id="@+id/nav_advanced"
        android:name="io.cloink.client.ui.advanced.AdvancedFragment"
        android:label="@string/menu_advanced" />

    <fragment
        android:id="@+id/nav_troubleshoot"
        android:name="io.cloink.client.ui.troubleshoot.TroubleshootFragment"
        android:label="@string/menu_troubleshoot" />

    <fragment
        android:id="@+id/nav_about"
        android:name="io.cloink.client.ui.about.AboutFragment"
        android:label="@string/menu_about" />

    <fragment
        android:id="@+id/nav_profiles"
        android:name="io.cloink.client.ui.profile.ProfilesFragment"
        android:label="@string/menu_profiles" />

    <fragment
        android:id="@+id/nav_change_server"
        android:name="io.cloink.client.ui.server.ChangeServerFragment"
        android:label="@string/menu_change_server">
        <argument
            android:name="hideAlert"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/firstInstallFragment"
        android:name="io.cloink.client.ui.fistinstall.FirstInstallFragment"
        android:label="FirstInstall" />
</navigation>
